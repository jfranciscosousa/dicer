{
  "name": "dicer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:socket": "tsx --env-file=.env src/dev.ts",
    "db:migrate": "wrangler d1 migrations apply dicer --local",
    "run": "tsx",
    "check": "tsc --noEmit",
    "test": "vitest run && tsx --test test/socket.test.ts",
    "build": "vite build",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "camelcase-keys": "^10.0.3",
    "dice-roller": "npm:@dice-roller/rpg-dice-roller@5.5.1",
    "discord": "npm:discordeno@^21.0.0",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "~5.1.0",
    "wrangler": "^4.158.0"
  }
}
