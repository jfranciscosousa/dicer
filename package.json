{
  "name": "dicer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26.11.1"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:socket": "tsx --env-file=.env src/dev.ts",
    "db:migrate": "wrangler d1 migrations apply dicer --local",
    "run": "tsx",
    "check": "tsc --noEmit",
    "test": "vitest run && tsx --test test/socket.test.ts",
    "build": "vite build",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "camelcase-keys": "^10.0.3",
    "dice-roller": "npm:@dice-roller/rpg-dice-roller@5.5.1",
    "discord": "npm:discordeno@^21.0.0",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "~4.1.0",
    "wrangler": "^4.149.0"
  }
}
