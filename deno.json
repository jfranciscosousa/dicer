{
  "imports": {
    "@/": "./src/",
    "camelcase-keys": "npm:camelcase-keys@^10.0.2",
    "dice-roller": "npm:@dice-roller/rpg-dice-roller@5.5.1",
    "discord": "npm:discordeno@^21.0.0",
    "dd-cache-proxy": "npm:dd-cache-proxy@^2.9.0",
    "hono": "npm:hono@^4.13.1",
    "zod": "npm:zod@^4.4.3",
    "zod-error": "npm:zod-error@^2.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "tasks": {
    "dev": "deno run --unstable-kv --allow-import=deno.land,unpkg.com --allow-net --allow-read=.env,.env.defaults,src/commands --env-file --allow-env --watch src/dev.ts --env-file",
    "prod": "deno run --unstable-kv --allow-import=deno.land,unpkg.com --allow-net --allow-read=.env,.env.defaults,src/commands --allow-env --watch src/prod.tsx --env-file",
    "run": "deno run --allow-read=.env,.env.defaults,src/commands --allow-import=deno.land,unpkg.com --allow-net --allow-env --env-file",
    "regen-lock": "deno cache --reload --frozen=false --allow-import=deno.land,unpkg.com src/dev.ts src/prod.tsx",
    "cache-all": "deno cache --allow-import=deno.land,unpkg.com src/dev.ts src/prod.tsx",
    "test": "deno test --unstable-kv --allow-env --allow-read --allow-write --env-file=.env.test test/*.ts test/**/*.ts",
    "check-all": "deno fmt --check --ignore=.pi-subagents && deno lint && deno check --allow-import=deno.land,unpkg.com,jsr.io src/*.ts src/**/*.ts tasks/*.ts test/*.ts test/**/*.ts"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  }
}
